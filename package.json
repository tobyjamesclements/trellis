{
  "name": "trellis",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first, LAN-local classroom platform built on Automerge",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:ci": "biome ci . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm i18n:report && pnpm build && pnpm test && pnpm e2e",
    "e2e": "pnpm --filter @trellis/client e2e",
    "i18n:report": "pnpm --filter @trellis/client i18n:report"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.19.0",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "1.56.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
