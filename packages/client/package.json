{
  "name": "@trellis/client",
  "version": "0.0.0",
  "private": true,
  "description": "The installable web application shell that runs on every device",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "vite build --logLevel warn",
    "dev": "vite",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "e2e": "vite build --logLevel warn && playwright test",
    "i18n:report": "node scripts/i18n-report.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@automerge/automerge-repo": "^2.5.6",
    "@automerge/automerge-repo-storage-indexeddb": "^2.5.6",
    "@trellis/core": "workspace:*",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
